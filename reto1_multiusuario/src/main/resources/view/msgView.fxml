<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="reto1_multiusuario.Client.Controller.PantallaPrincipal">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="5" left="10"/>
            </padding>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="IP:"/>
                <TextField fx:id="txtIp" prefWidth="110"/>
                <Label text="Puerto:"/>
                <TextField fx:id="txtPuerto" prefWidth="60"/>
                <Label text="Nombre:"/>
                <TextField fx:id="txtUsuario" prefWidth="110" promptText="tu nombre"/>
                <Button fx:id="btnConectar" text="Conectar" onAction="#onConectar"/>
                <Button fx:id="btnDesconectar" text="Desconectar" onAction="#onDesconectar"/>
            </HBox>

            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label fx:id="lblUsuario" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblEstado" text="Desconectado"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TextArea fx:id="txtChat" editable="false" wrapText="true">
            <BorderPane.margin>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </BorderPane.margin>
        </TextArea>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <padding>
                <Insets top="5" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Para:"/>
            <ComboBox fx:id="cmbDestinatario" prefWidth="150"/>
            <TextField fx:id="txtMensaje" promptText="Escribe un mensaje..."
                       onAction="#onEnviar" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnEnviar" text="Enviar" onAction="#onEnviar"/>
        </HBox>
    </bottom>

</BorderPane>
