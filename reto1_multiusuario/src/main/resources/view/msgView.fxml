<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450.0" prefWidth="760.0" spacing="8.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="reto1_multiusuario.Client.Controller.PantallaPrincipal">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="6.0">
         <children>
            <Label text="IP:" />
            <TextField fx:id="txtIp" prefWidth="110.0" promptText="127.0.0.1" />
            <Label text="Puerto:" />
            <TextField fx:id="txtPuerto" prefWidth="60.0" promptText="5050" />
            <Label text="Usuario:" />
            <TextField fx:id="txtUsuario" prefWidth="110.0" />
            <Button fx:id="btnConectar" mnemonicParsing="false" onAction="#onConectar" text="Conectar" />
            <Button fx:id="btnDesconectar" mnemonicParsing="false" onAction="#desconectar" text="Desconectar" />
            <Label fx:id="lblEstado" text="No conectado" />
         </children>
      </HBox>
      <TextArea fx:id="txtChat" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER_LEFT" spacing="6.0">
         <children>
            <CheckBox fx:id="chkPrivado" mnemonicParsing="false" onAction="#onPrivado" text="Privado" />
            <Label text="Para:" />
            <TextField fx:id="txtDestinatario" prefWidth="110.0" />
            <TextField fx:id="txtMensaje" onAction="#onEnviar" promptText="Escribe un mensaje" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnEnviar" mnemonicParsing="false" onAction="#onEnviar" text="Enviar" />
         </children>
      </HBox>
   </children>
</VBox>
